<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <LayoutRoomDef>
    <defName>NAT_AncientResearchFacilityCorridor</defName>
    <roomContentsWorkerType>NAT.RoomContents_FacilityCorridor</roomContentsWorkerType>
    <parts>
      <NAT_CornerNailTurret>0.8</NAT_CornerNailTurret>
      <NAT_DeadResearcher>
        <countRange>1~3</countRange>
      </NAT_DeadResearcher>
    </parts>
  </LayoutRoomDef>
  
  <!-- Containment -->

  <LayoutRoomDef>
    <defName>NAT_AncientContainmentRoom</defName>
    <isValidPlayerSpawnRoom>false</isValidPlayerSpawnRoom>
    <minSingleRectWidth>9</minSingleRectWidth>
    <minSingleRectHeight>9</minSingleRectHeight>
    <requiresSingleRectRoom>true</requiresSingleRectRoom>
    <canBeInMixedRoom>true</canBeInMixedRoom>
    <roomContentsWorkerType>NAT.RoomContents_ContainmentRoom</roomContentsWorkerType>
    <thingSetMakerDef>MapGen_OrbitalItemStash</thingSetMakerDef>
    <prefabs>
      <NAT_AncientHoldingPlatforms4_Shard>
        <minMaxRange>0~2</minMaxRange>
        <countRange>1~2</countRange>
      </NAT_AncientHoldingPlatforms4_Shard>
      <NAT_AncientHoldingPlatforms2_Shard>
        <minMaxRange>0~5</minMaxRange>
        <countRange>1~5</countRange>
      </NAT_AncientHoldingPlatforms2_Shard>
      <NAT_AncientHoldingPlatform_Cluster>
        <minMaxRange>0~5</minMaxRange>
        <countRange>1~5</countRange>
      </NAT_AncientHoldingPlatform_Cluster>
      <NAT_AncientHoldingPlatform>
        <minMaxRange>0~5</minMaxRange>
        <countRange>1~5</countRange>
      </NAT_AncientHoldingPlatform>
      <NAT_SealedSafe>
        <countRange>0~1</countRange>
      </NAT_SealedSafe>
      <AncientStorageCylinder_Edge>
        <countPerTenEdgeCells>2</countPerTenEdgeCells>
        <minMaxRange>2~8</minMaxRange>
      </AncientStorageCylinder_Edge>
      <AncientDisplayBank_Edge>
        <countPerTenEdgeCells>5</countPerTenEdgeCells>
        <minMaxRange>2~8</minMaxRange>
        <countRange>1~5</countRange>
      </AncientDisplayBank_Edge>
    </prefabs>
    <parts>
      <NAT_DeadResearcher>
        <countRange>3~5</countRange>
      </NAT_DeadResearcher>
      <NAT_CornerNailTurret>0.8</NAT_CornerNailTurret>
    </parts>
    <floorTypes>
      <li>AncientTile</li>
    </floorTypes>
  </LayoutRoomDef>

  <LayoutRoomDef>
    <defName>NAT_AncientWeaponsRoom</defName>
    <isValidPlayerSpawnRoom>false</isValidPlayerSpawnRoom>
    <minSingleRectWidth>8</minSingleRectWidth>
    <minSingleRectHeight>8</minSingleRectHeight>
    <areaSizeRange>64~150</areaSizeRange>
    <requiresSingleRectRoom>true</requiresSingleRectRoom>
    <canBeInMixedRoom>true</canBeInMixedRoom>
    <roomContentsWorkerType>NAT.RoomContents_VaultStorageRoom</roomContentsWorkerType>
    <thingSetMakerDef>NAT_MapGen_WeaponsRoom</thingSetMakerDef>
    <prefabs>
      <NAT_SealedCargo>
        <countRange>2~3</countRange>
      </NAT_SealedCargo>
      <NAT_SealedSafe_Edge>
        <minMaxRange>1~3</minMaxRange>
        <countRange>1~3</countRange>
        <ensureNoBlocks>false</ensureNoBlocks>
      </NAT_SealedSafe_Edge>
    </prefabs>
    <parts>
      <NAT_CornerNailTurret>
        <countRange>1~2</countRange>
      </NAT_CornerNailTurret>
    </parts>
    <floorTypes>
      <li>AncientTile</li>
    </floorTypes>
  </LayoutRoomDef>

  <LayoutRoomDef>
    <defName>NAT_ResearchCenterRoom</defName>
    <isValidPlayerSpawnRoom>false</isValidPlayerSpawnRoom>
    <minSingleRectWidth>12</minSingleRectWidth>
    <minSingleRectHeight>12</minSingleRectHeight>
    <areaSizeRange>130~99999</areaSizeRange>
    <requiresSingleRectRoom>true</requiresSingleRectRoom>
    <canBeInMixedRoom>false</canBeInMixedRoom>
    <roomContentsWorkerType>NAT.RoomContents_ResearchCenterRoom</roomContentsWorkerType>
    <prefabs>
      <NAT_SealedSafe>
        <countRange>2~4</countRange>
      </NAT_SealedSafe>
      <AncientStorageCylinder_Edge>
        <countPerTenEdgeCells>2</countPerTenEdgeCells>
        <minMaxRange>2~8</minMaxRange>
      </AncientStorageCylinder_Edge>
      <AncientDisplayBank_Edge>
        <countPerTenEdgeCells>5</countPerTenEdgeCells>
        <minMaxRange>2~8</minMaxRange>
        <countRange>1~5</countRange>
      </AncientDisplayBank_Edge>
    </prefabs>
    <parts>
      <NAT_CornerNailTurret>
        <countRange>2~2</countRange>
      </NAT_CornerNailTurret>
      <NAT_DeadResearcher>
        <countRange>2~7</countRange>
      </NAT_DeadResearcher>
    </parts>
    <floorTypes>
      <li>AncientTile</li>
    </floorTypes>
  </LayoutRoomDef>

</Defs>
    <label>dark metal platform</label>
    <spaceEdgeGraphicData MayRequire="Ludeon.RimWorld.Odyssey">
      <OShapeTexPath>Terrain/NAT_DarkMetalBorder/NAT_DarkMetalBorder_OShape</OShapeTexPath>
      <UShapeTexPath>Terrain/NAT_DarkMetalBorder/NAT_DarkMetalBorder_UShape</UShapeTexPath>
      <CornerInnerTexPath>Terrain/NAT_DarkMetalBorder/NAT_DarkMetalBorder_CornerInner</CornerInnerTexPath>
      <CornerOuterTexPath>Terrain/NAT_DarkMetalBorder/NAT_DarkMetalBorder_CornerOuter</CornerOuterTexPath>
      <FlatTexPath>Terrain/NAT_DarkMetalBorder/NAT_DarkMetalBorder_Flat</FlatTexPath>

      <LoopLeftTexPath>Terrain/NAT_DarkMetalPlatformEdge/NAT_DarkMetalEdge_Left</LoopLeftTexPath>
      <LoopRightTexPath>Terrain/NAT_DarkMetalPlatformEdge/NAT_DarkMetalEdge_Right</LoopRightTexPath>
      <LoopSingleTexPath>Terrain/NAT_DarkMetalPlatformEdge/NAT_DarkMetalEdge_Single</LoopSingleTexPath>

      <LoopTexPaths>
        <li>Terrain/NAT_DarkMetalPlatformEdge/NAT_DarkMetalEdge_Loop1</li>
        <li>Terrain/NAT_DarkMetalPlatformEdge/NAT_DarkMetalEdge_Loop2</li>
        <li>Terrain/NAT_DarkMetalPlatformEdge/NAT_DarkMetalEdge_Loop3</li>
        <li>Terrain/NAT_DarkMetalPlatformEdge/NAT_DarkMetalEdge_Loop4</li>
        <li>Terrain/NAT_DarkMetalPlatformEdge/NAT_DarkMetalEdge_Loop5</li>
      </LoopTexPaths>
    </spaceEdgeGraphicData>
  </TerrainDef>

  <TerrainDef ParentName="NAT_DarkMetalFloorBase">
    <defName>NAT_DarkMetalSubstructure</defName>
    <label>dark metal substructure</label>
    <spaceEdgeGraphicData MayRequire="Ludeon.RimWorld.Odyssey">
      <OShapeTexPath>Terrain/NAT_DarkMetalBorder/NAT_DarkMetalBorder_OShape</OShapeTexPath>
      <UShapeTexPath>Terrain/NAT_DarkMetalBorder/NAT_DarkMetalBorder_UShape</UShapeTexPath>
      <CornerInnerTexPath>Terrain/NAT_DarkMetalBorder/NAT_DarkMetalBorder_CornerInner</CornerInnerTexPath>
      <CornerOuterTexPath>Terrain/NAT_DarkMetalBorder/NAT_DarkMetalBorder_CornerOuter</CornerOuterTexPath>
      <FlatTexPath>Terrain/NAT_DarkMetalBorder/NAT_DarkMetalBorder_Flat</FlatTexPath>

      <LoopLeftTexPath>Terrain/NAT_DarkMetalSubstructureEdge/NAT_DarkMetalEdge_Left</LoopLeftTexPath>
      <LoopRightTexPath>Terrain/NAT_DarkMetalSubstructureEdge/NAT_DarkMetalEdge_Right</LoopRightTexPath>

        <li>Terrain/NAT_DarkMetalSubstructureEdge/NAT_DarkMetalEdge_Loop1</li>
        <li>Terrain/NAT_DarkMetalSubstructureEdge/NAT_DarkMetalEdge_Loop2</li>
        <li>Terrain/NAT_DarkMetalSubstructureEdge/NAT_DarkMetalEdge_Loop3</li>
        <li>Terrain/NAT_DarkMetalSubstructureEdge/NAT_DarkMetalEdge_Loop4</li>
        <li>Terrain/NAT_DarkMetalSubstructureEdge/NAT_DarkMetalEdge_Loop5</li>
